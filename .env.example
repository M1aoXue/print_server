# Flask应用配置
SECRET_KEY=your_secret_key

# 数据库配置
DATABASE_URI=mysql+mysqlconnector://username:password@localhost:3306/print_server

# 简道云配置
JANDOYUN_APP_ID=your_app_id
JANDOYUN_APP_SECRET=your_app_secret
JANDOYUN_API_URL=https://api.jiandaoyun.com/v1/
JANDOYUN_WEBHOOK_SECRET=your_webhook_secret

# 外部API配置
EXTERNAL_API_URL=https://api.example.com/
EXTERNAL_API_KEY=your_external_api_key

# 企业微信配置
WECHAT_CORPID=your_corpid
WECHAT_CORPSECRET=your_corpsecret
WECHAT_AGENTID=your_agentid
WECHAT_API_URL=https://qyapi.weixin.qq.com/cgi-bin